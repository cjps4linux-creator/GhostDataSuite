FROM alpine:3.18

LABEL maintainer="ghost-data-suite"
ENV GHOST_MODE=standard \
    SILENT_MODE=false

# Install runtime dependencies only. No SSH, no unnecessary shells.
RUN apk add --no-cache \
    python3 \
    py3-pip \
    curl \
    tzdata \
    sqlite-libs \
    && rm -rf /var/cache/apk/*

# Create a non-root user for the application.
RUN adduser -D -u 1000 ghostuser \
    && mkdir -p /app /data /keys /logs /media /tmp \
    && chown -R ghostuser:ghostuser /app /data /keys /logs /media /tmp

COPY scripts/entrypoint.sh /scripts/entrypoint.sh
COPY src/ghost_server.py /app/src/ghost_server.py
COPY src/security.py /app/src/security.py
COPY dashboard.html /app/dashboard.html
COPY requirements.ghost.txt /app/requirements.txt

WORKDIR /app

RUN pip install --no-cache-dir -r requirements.txt

# Expose only the application port. SSH is intentionally omitted.
EXPOSE 5000

USER ghostuser

CMD ["/scripts/entrypoint.sh"]
