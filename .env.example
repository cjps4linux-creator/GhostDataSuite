# Ghost-Data Suite configuration
# Copy to .env and fill in. NEVER commit the populated .env file.

# Authentication
GHOST_AUTH_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Database
DB_PATH=/app/data/alchemy.db
DB_ENCRYPTION_KEY=

# Encryption
ENCRYPTION_KEY_FILE=/app/keys/master.key
SECRET_FILE=/app/keys/secret.key

# Server
GHOST_PORT=5000
SILENT_MODE=false
LOG_LEVEL=INFO

# Alchemist (scraper)
TARGET_URL=
SCRAPE_INTERVAL=300
CONFIG_FILE=/app/config/config.yaml
LOG_PATH=/app/logs/alchemist.log
GHOST_DATA_DIR=/app/data
MEDIA_DIR=/app/media

# Security
SSL_CERT=/app/ssl/cert.pem
SSL_KEY=/app/ssl/key.pem
CORS_ORIGINS=http://localhost:5000
RATE_LIMIT=100 per minute
RATE_LIMIT_BURST=20
REDIS_URL=redis://localhost:6379/0

# Observability
JSON_LOGS=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# Monitoring
MONITORING_ENABLED=true
PROMETHEUS_PORT=9090
